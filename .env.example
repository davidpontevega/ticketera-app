# Antes de correr la primera migracion (`npm run db:generate` + aplicarla), ejecutar
# manualmente en la base de datos (Neon local y Cloud SQL prod):
#   CREATE EXTENSION IF NOT EXISTS pgcrypto;
# Los ids uuid de las tablas usan defaultRandom() (gen_random_uuid()), que depende de
# esta extension. drizzle-kit no gestiona extensiones, por eso es un paso manual.
DATABASE_URL=postgresql://user:password@host:5432/ticketera
