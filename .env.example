# --- Base de datos (Neon local / Cloud SQL prod, mismo schema, cambia solo DATABASE_URL) ---
# Antes de correr la primera migracion (`npm run db:generate` + aplicarla), ejecutar
# manualmente en la base de datos (Neon local y Cloud SQL prod):
#   CREATE EXTENSION IF NOT EXISTS pgcrypto;
# Los ids uuid de las tablas usan defaultRandom() (gen_random_uuid()), que depende de
# esta extension. drizzle-kit no gestiona extensiones, por eso es un paso manual.
DATABASE_URL=postgresql://user:password@host:5432/ticketera

# --- Clerk (https://dashboard.clerk.com -> API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Clerk -> Webhooks -> endpoint /api/webhooks/clerk -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Rutas propias de sign-in/up (se usan desde la fase 2)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# --- Stripe (https://dashboard.stripe.com -> Developers -> API keys) ---
# Modo test (sk_test_...). Solo servidor, nunca exponer al cliente.
STRIPE_SECRET_KEY=sk_test_xxx
# Local: salida de `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (whsec_...)
# Prod: Dashboard -> Developers -> Webhooks -> endpoint /api/webhooks/stripe con eventos
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_xxx
# No requerida con Checkout hosted (quedaria para Elements si se adopta en el futuro)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Stripe Connect (spec 042) ---
# Prerequisito: activar Connect en el Dashboard de Stripe, modo test (Settings -> Connect -> Get started,
# plataforma/marketplace con cuentas Express). Sin esto `stripe.accounts.create` falla.
# Apagado (default) = checkout identico al actual: cobra a la cuenta de la plataforma, sin comision.
STRIPE_CONNECT_ENABLED=false
# Pais de las cuentas Express de los organizadores (default US)
STRIPE_CONNECT_ACCOUNT_COUNTRY=US
# Webhook Connect (spec 048): endpoint DISTINTO al de pagos, con secreto propio (evento account.updated).
# Local: `stripe listen --forward-connect-to localhost:3000/api/webhooks/stripe-connect --events account.updated`
# Prod: Dashboard -> Developers -> Webhooks -> endpoint /api/webhooks/stripe-connect, "Listen to events on
# Connected accounts", evento account.updated
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx

# --- Retencion de payouts (spec 049) ---
# Dias tras el inicio del evento antes de poder retirar sus fondos (default 7). 0 para la demo.
PAYOUT_HOLD_DAYS=7
